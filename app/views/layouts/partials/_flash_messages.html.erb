<% unless flash.empty? %>
  <%# top-20 keeps flashes below the h-16 header; z-10 keeps them under the header (z-20) and its menus %>
  <div class="fixed inset-x-4 top-20 z-10 flex flex-col items-end gap-3 sm:inset-x-auto sm:right-6">
    <% flash.each do |type, message| %>
      <div data-controller="base--flash"
           class="relative w-full sm:w-110 rounded-lg border px-6 py-4 shadow-lg text-base <%= tailwind_class_for(type) %>"
           role="alert">
        <button type="button"
                data-action="click->base--flash#close"
                aria-label="Close"
                class="absolute top-2 right-2 text-xl leading-none font-bold text-gray-500 hover:text-gray-700">
          ×
        </button>
        <div class="text-center">
          <span class="font-medium"><%= message %></span>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
